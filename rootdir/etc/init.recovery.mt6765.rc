on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs
    # Force MediaTek musb-hdrc into USB peripheral mode regardless of ro.debuggable
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0

on post-fs
    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

on boot
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0
    setprop sys.usb.config adb

on property:ro.adb.secure.recovery=0
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0
    setprop sys.usb.config none
    setprop sys.usb.config adb

on property:sys.usb.config=adb
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0
    start adbd

on property:sys.usb.config=sideload
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0

on property:sys.usb.state=adb
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0

on property:sys.usb.state=sideload
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/devices/platform/mt_usb/musb-hdrc/cmode 2
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/mt_usb/saving 0

service watchdogd /system/bin/watchdogd 10 20
    class default
    user root
    group root
    seclabel u:r:watchdogd:s0
